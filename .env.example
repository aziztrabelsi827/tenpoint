# ------------------------------------------------------------------
# TenPoint environment variables
# Copy to `.env.local` and fill in real values.
# ------------------------------------------------------------------

# Supabase project URL (public — safe for the browser).
# Found in your Supabase dashboard under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon (public) key — safe for the browser.
# Found in your Supabase dashboard under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase service role key (SERVER-ONLY, never expose to the browser).
# Used ONLY for trusted server-side admin tasks (e.g. provisioning a user's
# profile during sign-up) via explicit server routes. All normal app data
# access goes through the authenticated user session, so this is OPTIONAL.
# If your profile is created by a database trigger on `auth.users`, you can
# leave it empty.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE_ROLE-KEY

# Application public origin (safe for the browser — used by robots.txt,
# sitemap.xml and Open Graph). Must match a host allowed in Supabase Auth
# -> Redirect URLs so the password-reset callback resolves.
# Local dev:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
NEXT_PUBLIC_SITE_URL=https://tenpoint.vercel.app

# Direct Postgres connection / pooler string (SERVER-ONLY — never expose to
# the browser). NOT required for the running application (all data access goes
# through the authenticated Supabase client + RLS). Needed ONLY for:
#   - applying SQL migrations via the Supabase CLI (`supabase db push`)
#   - the live database-integrity integration tests
# Leave empty unless you are performing one of those tasks.
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------------
# No DATABASE_URL is needed at runtime.
#
# Every user-owned row is read and written through the AUTHENTICATED Supabase
# server client, which attaches the session JWT to each PostgREST request.
# ROW LEVEL SECURITY (`user_id = auth.uid()`) enforces isolation at the
# database, so there is NO direct Postgres/Drizzle connection in the app path.
# A direct pool would connect as an RLS-exempt role and undermine isolation.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Integration-test env vars (OPTIONAL, only for tests/integration).
# Setting these enables the RLS two-user isolation tests;
# without them the suite auto-skips. Requires a provisioned project
# with migrations 0001 + 0002 + 0003 applied and two seeded accounts.
# ------------------------------------------------------------------
# TENTEST_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# TENTEST_ANON_KEY=YOUR-ANON-KEY
# TENTEST_USER_A_EMAIL=user-a@example.com
# TENTEST_USER_A_PASSWORD=...
# TENTEST_USER_B_EMAIL=user-b@example.com
# TENTEST_USER_B_PASSWORD=...

# ------------------------------------------------------------------
# Email delivery — Resend via Supabase Auth Custom SMTP
# ------------------------------------------------------------------
# TenPoint DOES NOT send authentication emails from Next.js. Supabase Auth owns
# signup confirmation, password reset and email-change; Resend acts purely as
# the SMTP delivery provider. The SMTP credentials are configured in the
# Supabase dashboard (Auth -> Sign In / Providers -> Email -> Custom SMTP), NOT
# in this file, and are never exposed to the browser.
#
# There is deliberately NO NEXT_PUBLIC_RESEND_API_KEY. Do not add the Resend API
# key to any client/browser variable. If you also need to send product/marketing
# email from our own server later, keep that server-only:
#   RESEND_API_KEY=re_xxxxxxxxx   (SERVER-ONLY, do NOT prefix with NEXT_PUBLIC_)
#
# Supabase Custom SMTP settings (enter in the Supabase dashboard):
#   SMTP host                  smtp.resend.com
#   SMTP port                  465 (SSL)  — or 587 (STARTTLS) if 465 is blocked
#   SMTP username              resend
#   SMTP password              <a Resend SMTP password, not your API key>
#   Sender email               no-reply@auth.YOUR_DOMAIN   (must be a verified
#                              Resend domain; use a subdomain for auth mail)
#   Sender name                TenPoint
#   Require secure connection  On
#
# You must verify the domain (SPF / DKIM / DMARC) in Resend and add the DNS
# records in your domain provider before the branded sender is deliverable.
# See README "Email delivery (Resend + Supabase Auth SMTP)" for the full
# step-by-step procedure.
# ------------------------------------------------------------------

